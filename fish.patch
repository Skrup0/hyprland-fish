 using namespace GL;
 
+static SP<ITexture> fishTex(PHLWINDOW pWindow, const std::string &part) {
+  static std::unordered_map<std::string, SP<ITexture>> cache;
+  static const auto DIRS = [] {
+    std::vector<std::filesystem::path> dirs;
+    std::error_code ec;
+    for (const auto &e : std::filesystem::directory_iterator(
+             std::filesystem::path(std::getenv("HOME")) / ".config/hypr/assets/fish", ec))
+      if (e.is_directory())
+        dirs.push_back(e.path());
+    return dirs;
+  }();
+  if (DIRS.empty())
+    return nullptr;
+  const auto &dir = DIRS[((uintptr_t)pWindow.get() >> 4) % DIRS.size()];
+  const auto path = dir / (dir.filename().string() + "-" + part + ".png");
+  auto &tex = cache[path];
+  if (!tex)
+    tex = ImgUtils::load(path);
+  return tex;
+}
